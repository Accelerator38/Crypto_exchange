CRYPTO_EXCHANGE=BITGET

MEXC_API_KEY=
MEXC_SECRET_KEY=
MEXC_TRADING_MODE=paper
MEXC_FUTURES_BASE_URL=https://api.mexc.com

BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=
# Separate Bitget Demo credentials. Never put live keys in these fields.
BITGET_DEMO_API_KEY=
BITGET_DEMO_SECRET_KEY=
BITGET_DEMO_PASSPHRASE=
# live_futures | demo_futures | paper | paper_live_feed
BITGET_TRADING_MODE=paper
# Close only Panteon-owned paper/demo positions during a controlled shutdown.
BITGET_PANTEON_V2_PAPER_CANARY_CLOSE_ON_SHUTDOWN=1
# multi: Pantheon selects one player from prior player/regime shadow results.
# singleton(PlayerLabel): keep one explicitly selected player fixed.
PANTEON_TRADE_REGIME=multi
# Required in addition to the live preflight only for singleton live trading.
PANTEON_ALLOW_LIVE_SINGLETON=0
